{
  "name": "cryptopay-js",
  "version": "2.0.0-rc.1",
  "description": "CryptoPay Checkout Widget — Accept crypto payments in minutes",
  "main": "dist/checkout.cjs",
  "module": "dist/checkout.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "provenance.json",
    "scripts/verify-package.cjs"
  ],
  "keywords": [
    "crypto",
    "payment",
    "widget",
    "checkout",
    "ethereum",
    "usdt",
    "web3",
    "blockchain",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/MarcoAR1/cryptopay-js.git"
  },
  "author": "MarcoAR1",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/checkout.mjs",
      "require": "./dist/checkout.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.cjs"
    },
    "./checkout.js": "./dist/checkout.js"
  },
  "scripts": {
    "dev": "rollup -c -w",
    "build": "rollup -c && node scripts/update-provenance.cjs && node scripts/verify-package.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs && node scripts/verify-package.cjs",
    "verify": "node scripts/verify-package.cjs",
    "prepack": "node scripts/verify-package.cjs",
    "prepublishOnly": "node scripts/verify-package.cjs --release"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^26.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rollup": "^4.0.0",
    "rollup-plugin-postcss": "^4.0.2",
    "tslib": "^2.6.0",
    "typescript": "^5.3.2"
  },
  "dependencies": {
    "qrcode": "^1.5.3"
  }
}
